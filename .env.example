# Copy this file to .env.local and fill in only the integrations you're
# actually activating. Every value here is optional — the site works fully
# with none of them set (content falls back to config/*.ts, and leads are
# just logged with a warning instead of being forwarded anywhere).

# ---- Content backend (src/lib/cms) ----
# Selects which content provider src/lib/cms/index.ts returns.
# Values: local (default) | sanity | contentful | strapi | wordpress
CMS_PROVIDER=local

# Sanity — see src/lib/cms/providers/sanity.ts for setup steps
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Contentful — see src/lib/cms/providers/contentful.ts
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Strapi — see src/lib/cms/providers/strapi.ts
STRAPI_URL=
STRAPI_API_TOKEN=

# WordPress Headless (WPGraphQL) — see src/lib/cms/providers/wordpress.ts
WORDPRESS_GRAPHQL_ENDPOINT=

# ---- Lead destinations (src/lib/leads) ----
# The contact form and growth-audit form both fan out to every destination
# below that has its env vars set (src/lib/leads/dispatch.ts). Enable as
# many or as few as you want.

# Generic webhook (Zapier, Make, n8n, or your own endpoint)
LEAD_WEBHOOK_URL=

# Resend (email) — see src/lib/leads/destinations/resend.ts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Google Sheets, via a published Apps Script Web App — see
# src/lib/leads/destinations/google-sheets.ts for the 4-step setup
GOOGLE_SHEETS_WEBHOOK_URL=

# Zoho CRM — see src/lib/leads/destinations/zoho.ts
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# HubSpot — Private App token with crm.objects.contacts.write scope
HUBSPOT_ACCESS_TOKEN=

# EmailJS server-side REST API — see src/lib/leads/destinations/emailjs.ts
# (uses the PRIVATE key, not the public key from their browser widget)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
